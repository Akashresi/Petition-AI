# ══════════════════════════════════════════════════════════════════
# PetitionAI – Environment Variables Template
# Copy to: backend/.env  (NEVER commit .env to git)
# ══════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────
# Phase 2: PostgreSQL (replacing MongoDB)
DATABASE_URL=postgresql://petition_user:password@localhost:5432/petition_ai
# Legacy MongoDB (kept for migration reference)
# MONGODB_URI=mongodb://localhost:27017/petition_ai
# USE_MONGODB=false

# ── JWT Authentication ────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# ── LLM (Gemini) ─────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Multilingual Embeddings ───────────────────────────────────────
# HuggingFace model for sentence-transformers (downloaded on first run)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── AI Engine Thresholds ──────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.55
AGREEMENT_TOLERANCE=0.20
DUPLICATE_THRESHOLD=0.75
DUPLICATE_WINDOW_DAYS=30
MIN_TEXT_LENGTH=20
SPAM_SCORE_THRESHOLD=0.60

# ── Reports ───────────────────────────────────────────────────────
REPORTS_DIR=reports

# ── Email (SMTP) ──────────────────────────────────────────────────
# Example: Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com

# ── SMS Notifications ─────────────────────────────────────────────
# Options: console (default, prints to stdout) | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Application ───────────────────────────────────────────────────
DEBUG=true
APP_VERSION=2.0.0